{
  "log": { "level": "warn", "timestamp": true, "output": "singbox.log" },
  "dns": {
    "servers": [
      { "type": "tcp", "tag": "remote", "server": "1.1.1.1", "detour": "xray" }
    ],
    "final": "remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "phonevpn-tun",
      "address": ["172.19.1.1/30", "fdfe:dcba:9877::1/126"],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    { "type": "socks", "tag": "xray", "server": "127.0.0.1", "server_port": 17890, "version": "5" },
    { "type": "direct", "tag": "direct" }
  ],
  "route": {
    "rules": [
      { "process_name": ["phonevpn-xray.exe"], "outbound": "direct" },
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      { "ip_is_private": true, "outbound": "direct" }
    ],
    "final": "xray",
    "auto_detect_interface": true,
    "default_domain_resolver": "remote"
  }
}
