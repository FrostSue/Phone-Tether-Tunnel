<!-- Loaded at runtime by DashboardWindow (no XAML compiler needed); event handlers are wired in code. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
      TextElement.FontSize="13"
      UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#0C0D12"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#11121A"/>
    <SolidColorBrush x:Key="CardBrush" Color="#171924"/>
    <SolidColorBrush x:Key="Card2Brush" Color="#1F2130"/>
    <SolidColorBrush x:Key="InputBrush" Color="#10111A"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#272B3C"/>
    <SolidColorBrush x:Key="TextBrush" Color="#ECEDF3"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8C92A8"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#5A6077"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccentHiBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A2246"/>
    <SolidColorBrush x:Key="UpBrush" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="BadBrush" Color="#EF4444"/>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18,16"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource Card2Brush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
              <Border x:Name="hover" CornerRadius="8" Background="#16FFFFFF" Visibility="Collapsed"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="hover" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="hover" Property="Background" Value="#2AFFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentHiBrush}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#2C1219"/>
      <Setter Property="BorderBrush" Value="#5F1D2A"/>
      <Setter Property="Foreground" Value="#FDA4AF"/>
    </Style>
    <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>

    <!-- Sidebar navigation -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Border x:Name="bg" CornerRadius="8" Background="Transparent"/>
              <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,9"
                      Background="{StaticResource AccentHiBrush}" Visibility="Collapsed"/>
              <StackPanel Orientation="Horizontal" Margin="14,9">
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}" FontSize="15" Width="20" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#0FFFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segmented control -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="6" Padding="12,5" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SegHost" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource InputBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="3"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Inputs -->
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Background" Value="{StaticResource InputBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource FaintBrush}" Margin="{TemplateBinding Padding}"
                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Padding="2,0,0,0"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="Text" Value="">
                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecretInput" TargetType="PasswordBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="b" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="10,7"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <DockPanel>
                <Border x:Name="box" DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                        BorderBrush="{StaticResource FaintBrush}" Background="Transparent" VerticalAlignment="Center">
                  <Path x:Name="mark" Data="M 3.5,8.5 L 6.8,11.8 L 12.8,4.8" Stroke="White" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="row" Property="Background" Value="#0CFFFFFF"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentHiBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim scrollbars -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" CornerRadius="4" Background="#363B52" Margin="2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Background" Value="#4A5070"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PageBtn" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PageBtn}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PageBtn}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="10"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PageBtn}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PageBtn}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                  <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{StaticResource Card2Brush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>

    <!-- Shared templates -->
    <DataTemplate x:Key="AppBarRow">
      <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="86"/>
          <ColumnDefinition Width="86"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="58"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="22" Height="22" CornerRadius="6" Background="{Binding Brush}">
            <TextBlock Text="{Binding Initial}" Foreground="#0C0D12" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding Name}" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="112"/>
        </StackPanel>
        <Grid Grid.Column="1" Height="8" Margin="4,0,14,0" VerticalAlignment="Center">
          <Border CornerRadius="4" Background="#22263A"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding BarFill}"/>
              <ColumnDefinition Width="{Binding BarRest}"/>
            </Grid.ColumnDefinitions>
            <Border CornerRadius="4" Background="{Binding Brush}"/>
          </Grid>
        </Grid>
        <TextBlock Grid.Column="2" Text="{Binding DownText}" Foreground="{StaticResource AccentHiBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="{Binding UpText}" Foreground="{StaticResource UpBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="4" Text="{Binding TotalText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="5" Text="{Binding ShareText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DayBar">
      <Grid Margin="6,0" ToolTip="{Binding Tip}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding TotalText}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="{Binding BarRest}"/>
            <RowDefinition Height="{Binding BarFill}"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="1" CornerRadius="5" Background="{Binding BarBrush}" MaxWidth="34"/>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
      </Grid>
    </DataTemplate>
  </Grid.Resources>

  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="232"/>
    <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <!-- ============================== SIDEBAR ============================== -->
  <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
    <DockPanel Margin="16,18,16,16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,22">
        <Image x:Name="LogoImage" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Phone Tether" FontSize="15" FontWeight="Bold"/>
          <TextBlock Text="Tunnel dashboard" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </StackPanel>

      <TextBlock DockPanel.Dock="Top" Text="PHONE" Style="{StaticResource Caption}" Margin="6,0,0,8"/>
      <Border DockPanel.Dock="Top" Style="{StaticResource SegHost}" HorizontalAlignment="Stretch" Margin="0,0,0,22">
        <UniformGrid Rows="1">
          <RadioButton x:Name="PlatformAndroid" GroupName="platform" Style="{StaticResource Seg}" Content="Android"/>
          <RadioButton x:Name="PlatformIphone" GroupName="platform" Style="{StaticResource Seg}" Content="iPhone"/>
        </UniformGrid>
      </Border>

      <TextBlock DockPanel.Dock="Top" Text="MENU" Style="{StaticResource Caption}" Margin="6,0,0,6"/>
      <StackPanel DockPanel.Dock="Top">
        <RadioButton x:Name="NavOverview" GroupName="nav" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Overview" IsChecked="True"/>
        <RadioButton x:Name="NavUsage" GroupName="nav" Style="{StaticResource Nav}" Tag="&#xE9D2;" Content="Data usage"/>
        <RadioButton x:Name="NavConnections" GroupName="nav" Style="{StaticResource Nav}" Tag="&#xE968;" Content="Connections"/>
        <RadioButton x:Name="NavLogs" GroupName="nav" Style="{StaticResource Nav}" Tag="&#xE8A5;" Content="Logs"/>
        <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Settings"/>
      </StackPanel>

      <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
              CornerRadius="10" Padding="12,10" VerticalAlignment="Bottom">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="SideDot" Width="8" Height="8" Fill="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="SideStatus" Text="Checking…" Margin="8,0,0,0" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock x:Name="SideSpeed" Text="" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="16,4,0,0"/>
          <TextBlock x:Name="SideFolder" Text="" Foreground="{StaticResource FaintBrush}" FontSize="10.5" Margin="0,8,0,0"
                     TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}"/>
        </StackPanel>
      </Border>
    </DockPanel>
  </Border>

  <!-- ============================== CONTENT ============================== -->
  <Grid Grid.Column="1" Margin="28,22,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,18">
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="PageTitle" Text="Overview" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="PageSubtitle" Text="" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="TestBtn" Style="{StaticResource Btn}" Margin="0,0,8,0" ToolTip="Run test.ps1 (phone, proxy, UDP and leak checks)">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}"/><TextBlock Text="Diagnose" Margin="8,0,0,0"/></StackPanel>
        </Button>
        <Button x:Name="StopBtn" Style="{StaticResource DangerBtn}" Margin="0,0,8,0" ToolTip="Stop the tunnel (asks for administrator rights)">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" Style="{StaticResource Icon}"/><TextBlock Text="Stop" Margin="8,0,0,0"/></StackPanel>
        </Button>
        <Button x:Name="StartBtn" Style="{StaticResource PrimaryBtn}" ToolTip="Start or restart the tunnel (asks for administrator rights)">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}"/><TextBlock x:Name="StartBtnText" Text="Start" Margin="8,0,0,0"/></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <!-- ============ OVERVIEW ============ -->
      <Grid x:Name="PageOverview">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="190"/>
          <RowDefinition Height="250"/>
        </Grid.RowDefinitions>
        <UniformGrid Rows="1" Columns="4" Margin="-6,0,-6,0">
          <Border Style="{StaticResource Card}" Margin="6,0">
            <StackPanel>
              <TextBlock Text="TUNNEL" Style="{StaticResource Caption}"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                <Ellipse x:Name="OvDot" Width="10" Height="10" Fill="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="OvStatus" Text="…" FontSize="20" FontWeight="SemiBold" Margin="9,0,0,0"/>
              </StackPanel>
              <TextBlock x:Name="OvCores" Text="" Style="{StaticResource Sub}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="6,0">
            <StackPanel>
              <TextBlock Text="PHONE" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="OvPhone" Text="…" Style="{StaticResource Big}" FontSize="20" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="OvLink" Text="" Style="{StaticResource Sub}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="6,0">
            <StackPanel>
              <TextBlock Text="LIVE SPEED" Style="{StaticResource Caption}"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentHiBrush}"/>
                <TextBlock x:Name="OvDown" Text="0 B/s" FontSize="20" FontWeight="SemiBold" Margin="6,0,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Foreground="{StaticResource UpBrush}" FontSize="12"/>
                <TextBlock x:Name="OvUp" Text="0 B/s" Style="{StaticResource Sub}" Margin="6,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="6,0">
            <StackPanel>
              <TextBlock Text="TODAY" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="OvToday" Text="0 B" Style="{StaticResource Big}" FontSize="20"/>
              <TextBlock x:Name="OvTodaySplit" Text="" Style="{StaticResource Sub}"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
              <TextBlock Text="Throughput · last 60 seconds" Style="{StaticResource CardTitle}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource AccentHiBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Download" Foreground="{StaticResource MutedBrush}" Margin="6,0,14,0" FontSize="12"/>
                <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource UpBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Upload" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0" FontSize="12"/>
              </StackPanel>
            </Grid>
            <TextBlock DockPanel.Dock="Bottom" x:Name="OvSource" Text="" Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="0,8,0,0"/>
            <Canvas x:Name="SpeedCanvas" ClipToBounds="True" Background="Transparent"/>
          </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="2*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="Top apps this session" Style="{StaticResource CardTitle}"/>
                <Button x:Name="OvOpenBoard" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" Margin="0,-6,-8,0" Content="Open board ›"/>
              </Grid>
              <TextBlock x:Name="OvTopEmpty" DockPanel.Dock="Top" Text="No traffic through the tunnel yet." Foreground="{StaticResource FaintBrush}" Margin="0,6,0,0"/>
              <ItemsControl x:Name="OvTopApps" ItemTemplate="{StaticResource AppBarRow}"/>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Last 7 days" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
              <ItemsControl x:Name="OvDays" ItemTemplate="{StaticResource DayBar}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- ============ DATA USAGE ============ -->
      <Grid x:Name="PageUsage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <UniformGrid Rows="1" Columns="4" Margin="-6,0,-6,0">
          <Border Style="{StaticResource Card}" Margin="6,0">
            <StackPanel>
              <TextBlock Text="SESSION" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="UsSession" Text="0 B" Style="{StaticResource Big}"/>
              <TextBlock x:Name="UsSessionSplit" Text="" Style="{StaticResource Sub}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="6,0">
            <StackPanel>
              <TextBlock Text="TODAY" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="UsToday" Text="0 B" Style="{StaticResource Big}"/>
              <TextBlock x:Name="UsTodaySplit" Text="" Style="{StaticResource Sub}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="6,0">
            <StackPanel>
              <TextBlock Text="TOTAL (ALL TIME)" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="UsTotal" Text="0 B" Style="{StaticResource Big}"/>
              <TextBlock x:Name="UsTotalSplit" Text="" Style="{StaticResource Sub}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="6,0">
            <StackPanel>
              <TextBlock Text="MEASURED ON" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="UsSource" Text="…" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,4" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="UsMode" Text="" Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="280"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- App picker -->
            <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
              <DockPanel Margin="16,16,12,12">
                <TextBlock DockPanel.Dock="Top" Text="Apps" Style="{StaticResource CardTitle}"/>
                <TextBlock DockPanel.Dock="Top" Text="Tick the apps you want on the board." Style="{StaticResource Sub}" Margin="0,2,0,10"/>
                <TextBox DockPanel.Dock="Top" x:Name="AppSearch" Style="{StaticResource Input}" Tag="Search apps…" Margin="0,0,0,8"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="-6,0,0,6">
                  <Button x:Name="SelectAllBtn" Style="{StaticResource GhostBtn}" Content="Select all"/>
                  <Button x:Name="SelectNoneBtn" Style="{StaticResource GhostBtn}" Content="Clear"/>
                  <Button x:Name="SelectTopBtn" Style="{StaticResource GhostBtn}" Content="Top 5"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-6,0,-6,0">
                  <ItemsControl x:Name="AppPickList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="8,7">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding TotalText}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                          </Grid>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <!-- Board -->
            <DockPanel Grid.Column="1" Margin="20,16,20,14">
              <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Usage board" Style="{StaticResource CardTitle}"/>
                  <TextBlock x:Name="BoardSubtitle" Text="" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                  <Border Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="ScopeSession" GroupName="scope" Style="{StaticResource Seg}" Content="Session" IsChecked="True"/>
                      <RadioButton x:Name="ScopeAll" GroupName="scope" Style="{StaticResource Seg}" Content="All time"/>
                    </StackPanel>
                  </Border>
                  <Button x:Name="ResetSessionBtn" Style="{StaticResource Btn}" Margin="10,0,0,0" Padding="12,6" FontWeight="Normal"
                          ToolTip="Start a new session (all-time totals are kept)">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock Text="New session" Margin="7,0,0,0"/></StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="4" Margin="-5,0,-5,16">
                <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14,11" Margin="5,0">
                  <StackPanel>
                    <TextBlock x:Name="SelTitle" Text="SELECTED" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="SelTotal" Text="0 B" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14,11" Margin="5,0">
                  <StackPanel>
                    <TextBlock Text="DOWNLOAD" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="SelDown" Text="0 B" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" Foreground="{StaticResource AccentHiBrush}"/>
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14,11" Margin="5,0">
                  <StackPanel>
                    <TextBlock Text="UPLOAD" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="SelUp" Text="0 B" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" Foreground="{StaticResource UpBrush}"/>
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14,11" Margin="5,0">
                  <StackPanel>
                    <TextBlock Text="SHARE OF ALL APPS" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="SelShare" Text="–" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="86"/>
                  <ColumnDefinition Width="86"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="APP" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Column="2" Text="DOWN" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="UP" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="TOTAL" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="SHARE" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
              </Grid>
              <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource StrokeBrush}" Margin="0,4,0,6"/>

              <Grid>
                <TextBlock x:Name="SelEmpty" Text="Pick one or more apps on the left to compare their usage."
                           Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="SelectedBars" ItemTemplate="{StaticResource AppBarRow}"/>
                </ScrollViewer>
              </Grid>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- ============ CONNECTIONS ============ -->
      <Border x:Name="PageConnections" Visibility="Collapsed" Style="{StaticResource Card}" Padding="0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="18,14,18,10">
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="ConnSearch" Style="{StaticResource Input}" Width="260" Tag="Filter by app or destination…"/>
              <Border Style="{StaticResource SegHost}" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="ConnAll" GroupName="connf" Style="{StaticResource Seg}" Content="All" IsChecked="True"/>
                  <RadioButton x:Name="ConnTunnel" GroupName="connf" Style="{StaticResource Seg}" Content="Tunnel"/>
                  <RadioButton x:Name="ConnDirect" GroupName="connf" Style="{StaticResource Seg}" Content="Direct"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBlock x:Name="ConnInfo" Text="" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <Border DockPanel.Dock="Top" Background="{StaticResource Card2Brush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1">
            <Grid Margin="18,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="80"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="APP" Style="{StaticResource Caption}"/>
              <TextBlock Grid.Column="1" Text="NET" Style="{StaticResource Caption}"/>
              <TextBlock Grid.Column="2" Text="DESTINATION" Style="{StaticResource Caption}"/>
              <TextBlock Grid.Column="3" Text="ROUTE" Style="{StaticResource Caption}"/>
              <TextBlock Grid.Column="4" x:Name="ConnColDown" Text="DOWN" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="5" x:Name="ConnColUp" Text="UP" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="6" x:Name="ConnColSpeed" Text="SPEED" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="7" x:Name="ConnColAge" Text="AGE" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
            </Grid>
          </Border>
          <Grid>
            <TextBlock x:Name="ConnEmpty" Text="No connections." Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="ConnList" Margin="0,2,0,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="row" Padding="18,6" Background="Transparent">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="170"/>
                          <ColumnDefinition Width="56"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="92"/>
                          <ColumnDefinition Width="86"/>
                          <ColumnDefinition Width="86"/>
                          <ColumnDefinition Width="92"/>
                          <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding App}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Network}" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Destination}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding Destination}"/>
                        <Border Grid.Column="3" x:Name="pill" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left" Background="#1B3A2E">
                          <TextBlock x:Name="pillText" Text="{Binding Route}" FontSize="11.5" Foreground="#4ADE80"/>
                        </Border>
                        <TextBlock Grid.Column="4" Text="{Binding DownText}" HorizontalAlignment="Right" Foreground="{StaticResource AccentHiBrush}"/>
                        <TextBlock Grid.Column="5" Text="{Binding UpText}" HorizontalAlignment="Right" Foreground="{StaticResource UpBrush}"/>
                        <TextBlock Grid.Column="6" Text="{Binding SpeedText}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="7" Text="{Binding AgeText}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Tunnel}" Value="False">
                        <Setter TargetName="pill" Property="Background" Value="#3A2A12"/>
                        <Setter TargetName="pillText" Property="Foreground" Value="#FBBF24"/>
                      </DataTrigger>
                      <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                        <Setter TargetName="row" Property="Background" Value="#0AFFFFFF"/>
                      </Trigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>

      <!-- ============ LOGS ============ -->
      <Border x:Name="PageLogs" Visibility="Collapsed" Style="{StaticResource Card}" Padding="0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="18,14,18,12">
            <Border Style="{StaticResource SegHost}">
              <StackPanel x:Name="LogSources" Orientation="Horizontal"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <CheckBox x:Name="AutoScroll" Style="{StaticResource Check}" Content="Follow" IsChecked="True" Padding="6,5" Margin="0,0,8,0"/>
              <Button x:Name="ClearLogBtn" Style="{StaticResource GhostBtn}" Content="Clear view"/>
              <Button x:Name="OpenFolderBtn" Style="{StaticResource Btn}" Margin="6,0,0,0" Padding="12,6" FontWeight="Normal">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock Text="Open folder" Margin="7,0,0,0"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <TextBlock DockPanel.Dock="Top" x:Name="LogPath" Text="" Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="18,0,18,8" FontFamily="{StaticResource MonoFont}"/>
          <Border Background="#0A0B10" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
            <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#C9CEDD"
                     FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="16,10" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" SelectionBrush="{StaticResource AccentBrush}"/>
          </Border>
        </DockPanel>
      </Border>

      <!-- ============ SETTINGS ============ -->
      <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="FolderCardTitle" Text="Install folder" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="Folder of the copy running on this PC. Scripts, logs, configs and the usage statistics are read from here."
                         Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,12"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" Style="{StaticResource Input}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                  <Button x:Name="BrowseBtn" Style="{StaticResource Btn}" Content="Browse…" Margin="0,0,6,0"/>
                  <Button x:Name="DetectBtn" Style="{StaticResource Btn}" Content="Auto-detect" Margin="0,0,6,0"/>
                  <Button x:Name="ApplyFolderBtn" Style="{StaticResource PrimaryBtn}" Content="Use folder"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="FolderHint" Text="" Style="{StaticResource Sub}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Per-app usage" Style="{StaticResource CardTitle}"/>
              <TextBlock x:Name="ClashStatus" Text="" Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,12"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="EnableClashBtn" Style="{StaticResource PrimaryBtn}" Content="Enable exact per-app tracking" Margin="0,0,8,0"/>
                <Button x:Name="RestartBtn" Style="{StaticResource Btn}" Content="Restart tunnel now"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="sing-box log level" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="Written to the sing-box config; applies after the tunnel restarts." Style="{StaticResource Sub}" Margin="0,3,0,12"/>
              <Border Style="{StaticResource SegHost}">
                <StackPanel x:Name="LogLevelPanel" Orientation="Horizontal"/>
              </Border>
            </StackPanel>
          </Border>

          <Border x:Name="IphoneCard" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="iPhone · Shadowrocket" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="settings.json and vless.txt in the install folder. The watcher reads them when it starts, so changes apply after a restart."
                         Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,14"/>
              <TextBlock Text="PROXY SHARE PORTS TO PROBE" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
              <TextBox x:Name="SetPorts" Style="{StaticResource Input}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,0,14"/>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="VLESS MODE" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                  <Border Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="VlessUdp" GroupName="vless" Style="{StaticResource Seg}" Content="UDP only (Discord voice)"/>
                      <RadioButton x:Name="VlessAll" GroupName="vless" Style="{StaticResource Seg}" Content="All traffic"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="CHECK INTERVAL (SEC)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                  <TextBox x:Name="SetInterval" Style="{StaticResource Input}"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="VLESS LINK (LEAVE EMPTY TO KEEP THE CURRENT ONE)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
              <PasswordBox x:Name="SetVless" Style="{StaticResource SecretInput}" Margin="0,0,0,6"/>
              <TextBlock x:Name="VlessHint" Text="" Style="{StaticResource Sub}" Margin="0,0,0,14"/>
              <Button x:Name="SaveIphoneBtn" Style="{StaticResource PrimaryBtn}" Content="Save iPhone settings" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>

          <Border x:Name="AndroidCard" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Android · Exclave" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="The Android watcher finds the phone on its own (Exclave SOCKS5 on port 2080, USB tethering preferred over Wi-Fi). There is nothing to configure here."
                         Style="{StaticResource Sub}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Grid>
